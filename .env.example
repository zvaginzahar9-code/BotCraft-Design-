# Подключение к PostgreSQL.
# Скопируйте файл в .env.local и подставьте свои значения:
#   cp .env.example .env.local
#
# Имена переменных стандартные для PostgreSQL (libpq): их читают и драйвер
# приложения, и psql, поэтому больше нигде подключение настраивать не нужно.

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=botcraft_design

# Альтернатива для размещённых баз, которые выдают одну готовую строку. Если
# задана, используется вместо переменных выше. Спецсимволы пароля (@ : / ? #)
# требуют percent-encoding.
# DATABASE_URL=postgresql://postgres:ПАРОЛЬ@localhost:5432/botcraft_design
#
# Пример для Supabase. Приложению нужен Transaction Pooler (порт 6543) — он
# рассчитан на serverless-среду вроде Vercel, где соединения короткие и
# многочисленные:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Для `npm run db:seed` у того же адреса берут порт 5432 (Session Pooler):
# транзакционный режим не поддерживает сессионные возможности, и создавать
# таблицы через него не рекомендуется.
